PORT=3000

# true loads public demo data; refused when NODE_ENV=production.
# Read from the process environment (the app does not load .env yet): DEMO_DATA=true npm run start:dev
DEMO_DATA=false

# Access token signing key: ES256, a P-256 private key as PKCS#8 PEM, and its key id (`kid`).
# Outside production, an empty JWT_PRIVATE_KEY generates a key for this process only (tokens stop
# working at restart, a warning is logged). The application does not start in production without one.
# Make a key:  openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# A PEM on one line, with literal \n between the lines, also works.
JWT_PRIVATE_KEY=
JWT_KEY_ID=

# Master key of the raw comment encryption (SDD 6.5; KMS in production later): 32 random bytes as
# base64, and its id. Outside production an empty RAW_TEXT_KEY generates a key for this process only
# (a warning is logged). The application does not start in production without one.
# Make a key:  openssl rand -base64 32
RAW_TEXT_KEY=
RAW_TEXT_KEY_ID=

# B2B access token signing key: ES256 (P-256, PKCS#8 PEM) and its key id; its own key, never the
# mobile one. Outside production an empty value generates a key for this process only; required in
# production. Make a key the same way as JWT_PRIVATE_KEY.
B2B_JWT_PRIVATE_KEY=
B2B_JWT_KEY_ID=
# Demo B2B clients (needs DEMO_DATA=true; refused with NODE_ENV=production). A JSON array, secrets at
# least 32 characters, e.g. (make a secret with: openssl rand -base64 32):
# B2B_DEMO_CLIENTS=[{"clientId":"fuel-panel","brand":"fuel","secret":"<secret>","scope":"b2b.feedback.read b2b.summary.read"}]
B2B_DEMO_CLIENTS=

# Job queue (ADR-009): `memory` (default: tests and the single-process demo) or `bullmq` (Redis).
QUEUE_DRIVER=
# Redis for QUEUE_DRIVER=bullmq: redis://[user:password@]host[:port][/db] (rediss:// for TLS).
# Empty means redis://localhost:6379 (docker compose up -d redis).
REDIS_URL=
# The worker process (main.worker.ts) gives a running job this many milliseconds to finish after
# SIGTERM/SIGINT; then it closes the connections and exits with code 1 (BullMQ reruns the job as
# stalled). Empty means 25000, below the 30 s an ECS task gets.
WORKER_SHUTDOWN_TIMEOUT_MS=

# true runs the outbox relay and the analysis worker on a 1-second timer inside the API process
# (the single-process demo, in-memory queue). The separate worker process with Redis is main.worker.ts.
RUN_WORKER_IN_API=

# LLM provider (FR-AI-06): `openai`, or `fake` (labels everything as valid, neutral, topic `other`;
# refused with NODE_ENV=production). Empty means `fake` outside production.
LLM_DRIVER=
# Needed with LLM_DRIVER=openai. The model is chosen by measurement in S0-13 (ADR-018).
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: a proxy or a local test server instead of https://api.openai.com/v1
OPENAI_BASE_URL=

# docker-compose.yml (local development only)
POSTGRES_USER=feedback
POSTGRES_PASSWORD=feedback
POSTGRES_DB=feedback
