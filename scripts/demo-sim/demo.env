# Environment of `npm run start:demo` (the API for the demo).
# A variable already set in the shell wins over this file (Node's --env-file does not overwrite).
PORT=3000

# Loads the demo catalog (2 brands, 10 branches, QR tokens); refused when NODE_ENV=production.
DEMO_DATA=true

# Runs the outbox relay and the analysis worker inside the API process (single-process demo).
RUN_WORKER_IN_API=true

# `fake` labels every comment valid / neutral / "other". For real analysis set LLM_DRIVER=openai,
# OPENAI_API_KEY and OPENAI_MODEL in the shell before starting; never put the key in this file.
LLM_DRIVER=fake

# Demo B2B clients, one per demo brand. The secrets are public on purpose: they open only the
# fictional demo brands, need DEMO_DATA=true, and B2B_DEMO_CLIENTS is refused in production.
B2B_DEMO_CLIENTS='[{"clientId":"fuel-panel","brand":"fuel","secret":"demo-fuel-panel-secret-0123456789abcdef","scope":"b2b.feedback.read b2b.summary.read"},{"clientId":"coffee-panel","brand":"coffee","secret":"demo-coffee-panel-secret-0123456789abcd","scope":"b2b.feedback.read b2b.summary.read"}]'